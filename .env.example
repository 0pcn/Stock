# 本機 Google OAuth：不要把 Client Secret 貼到聊天或提交 Git。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# 同一個 Google Cloud 專案下的 Apps Script API 執行檔部署 ID
GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=

# 正式 Worker 另透過 Sites 設定以上值與下列金鑰；正式回呼必須用網站的 HTTPS 網址。
# 用 32 個隨機位元組的 base64url 字串。只供伺服器加密，不得放入前端環境變數。
GOOGLE_TOKEN_ENCRYPTION_KEY=
